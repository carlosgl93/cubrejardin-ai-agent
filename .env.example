OPENAI_API_KEY=your_openai_api_key_here

WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_TARGET_APP_ID=your_facebook_app_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
SKIP_WEBHOOK_SIGNATURE_VALIDATION=false

WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app/webhook/whatsapp
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
REDIS_URL=redis://redis:6379/0

# Optional: only if you enable Messenger
FACEBOOK_MESSENGER_PAGE_TOKEN=
FACEBOOK_MESSENGER_VERIFY_TOKEN=
FACEBOOK_MESSENGER_TENANT_ID=legacy_single_tenant_uuid_optional

DEFAULT_TEMPLATE_NAME=session_expired
TEMPLATE_MAPPING={"handoff":"handoff_notification","session_expired":"session_expired"}
MERCADO_FIEL_API_TARGET=https://southamerica-west1-mercado-fiel.cloudfunctions.net/api
MERCADO_FIEL_API_KEY=your_mercado_fiel_api_key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# RAG / pgvector
VECTOR_BACKEND=pgvector
EMBEDDING_DIMENSION=1536
MATCH_DOCUMENTS_RPC=match_documents
DOCUMENTS_PATH=data/documents

